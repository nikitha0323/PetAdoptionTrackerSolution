@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

<h2>Appearance</h2>
<p>Choose a theme for the application.</p>

<button type="button"
        class="btn btn-outline-primary"
        data-theme-choice="light">
    Light theme
</button>

<button type="button"
        class="btn btn-outline-primary"
        data-theme-choice="dark">
    Dark theme
</button>

<p id="themeStatus" class="mt-3" aria-live="polite"></p>